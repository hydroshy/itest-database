# PostgreSQL 17 Deployment Configuration for ITEST Platform

# Database Superuser Credentials
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=itest_secure_password_2026
POSTGRES_DB=itest_platform
POSTGRES_PORT=5432

# Multi-Schema Dedicated Service Credentials
SYSTEM_DB_USER=itest_system_user
SYSTEM_DB_PASS=system_secret_2026

PLUGINS_DB_USER=itest_plugins_user
PLUGINS_DB_PASS=plugins_secret_2026

OPS_DB_USER=itest_ops_user
OPS_DB_PASS=ops_secret_2026

# Git Fetch (Dockge deployment)
DB_REPO_URL=https://github.com/hydroshy/itest-database.git
DB_REPO_BRANCH=main

# pgAdmin
PGADMIN_EMAIL=admin@itest.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
